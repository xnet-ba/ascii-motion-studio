# ASCII Motion Studio - Environment Configuration

# Server
APP_NAME="ASCII Motion Studio"
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8001
APP_URL=https://go.kolektiv.pro

# Security
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
API_TOKEN=change-this-to-a-random-api-token
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Paths
APP_DIR=/opt/ascii-motion-studio
DATA_DIR=/var/lib/ascii-motion-studio
LOG_DIR=/var/log/ascii-motion-studio
TEMP_DIR=/var/tmp/ascii-motion-studio

# Limits
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=20
MAX_VIDEO_WIDTH=1920
MAX_VIDEO_HEIGHT=1080
MAX_ASCII_WIDTH=240
MAX_FRAMES=300
CONCURRENT_JOBS=2

# Defaults
DEFAULT_FPS=15
DEFAULT_ASCII_WIDTH=120
DEFAULT_VIDEO_DURATION_LIMIT=20

# Processing
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
IMAGEMAGICK_CONVERT_PATH=/usr/bin/convert
IMAGEMAGICK_IDENTIFY_PATH=/usr/bin/identify

# Logging
LOG_LEVEL=INFO
