[Unit]
Description=ASCII Motion Studio Worker
After=network.target ascii-motion-api.service

[Service]
Type=simple
User=sha
Group=sha
WorkingDirectory=/opt/ascii-motion-studio/backend
Environment=PYTHONPATH=/opt/ascii-motion-studio/backend
EnvironmentFile=/opt/ascii-motion-studio/backend/.env
ExecStart=/opt/ascii-motion-studio/backend/venv/bin/python workers/runner.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/ascii-motion-studio/worker.log
StandardError=append:/var/log/ascii-motion-studio/worker.log

[Install]
WantedBy=multi-user.target
